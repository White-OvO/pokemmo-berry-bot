# Copy this file to .env and fill in your own values.
# Get these from https://discord.com/developers/applications

DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# Optional: set this to a server (guild) ID while developing.
# Guild-scoped commands update instantly; global commands can take up to an hour.
# Leave blank to register commands globally once you're ready to deploy for real.
GUILD_ID=
